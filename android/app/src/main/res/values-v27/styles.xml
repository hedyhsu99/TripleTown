<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- API 27+：主題層宣告內容延伸進瀏海（display cutout）區，
         避免全螢幕時系統在螢幕上緣留一條 letterbox 白邊 -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowBackground">@color/gameBackground</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:statusBarColor">#3a5230</item>
        <item name="android:navigationBarColor">#3a5230</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
