<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 15（API 35+）：強制 edge-to-edge 會讓 windowFullscreen 失效，
         宣告豁免（opt-out）讓傳統全螢幕設定恢復作用 -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowBackground">@color/gameBackground</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:statusBarColor">#3a5230</item>
        <item name="android:navigationBarColor">#3a5230</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>
</resources>
